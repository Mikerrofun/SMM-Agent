# Database
DATABASE_URL="postgresql://user:password@localhost:5432/smm_agent"

# Telegram Bot (for bot.ts)
TELEGRAM_BOT_TOKEN=""

# Telegram MTProto API (for parsers)
# Get your API credentials from https://my.telegram.org/auth
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""
# Session string will be generated on first authorization (leave empty initially)
TELEGRAM_SESSION_STRING=""

# Admin notifications (for cron reports)
# Your personal Telegram chat ID for receiving automatic pipeline reports
ADMIN_CHAT_ID=""

# OpenAI
OPENAI_API_KEY=""

# Cron Configuration
# Enable/disable automatic scheduled runs (default: true)
CRON_ENABLED="true"
# Cron schedule in UTC timezone (default: "50 6 * * 2,4" = Tuesday and Thursday at 9:50 MSK)
# Format: "minute hour day month dayOfWeek"
# Examples:
#   "50 6 * * 2,4"  - Tuesday and Thursday at 9:50 MSK (6:50 UTC)
#   "0 7 * * 2,4"   - Tuesday and Thursday at 10:00 MSK (7:00 UTC)
#   "0 10 * * *"    - Every day at 10:00 UTC
CRON_SCHEDULE="50 6 * * 2,4"

# App
NODE_ENV="development"
