{
  "name": "smm-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && NEXT_SKIP_PRERENDER=1 next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "prisma:studio": "prisma studio",
    "bot": "tsx src/bot/run.ts",
    "bot:dev": "tsx watch src/bot/run.ts",
    "test:ai": "tsx src/ai/test.ts",
    "check:models": "tsx src/ai/check-models.ts",
    "parse:natalia": "tsx src/parser/natalia/run.ts",
    "parse:competitors": "tsx src/parser/competitors/run.ts",
    "extract:mainidea:natalia": "tsx src/scripts/extractMainIdea/natalia.ts",
    "generate:embeddings:natalia": "tsx src/scripts/generateEmbeddings/natalia.ts",
    "generate:ideas:competitors": "tsx src/scripts/generateIdeas/competitorPostsToIdeas.ts",
    "deduplicate:ideas": "tsx src/scripts/deduplicateIdeas/run.ts",
    "seed:competitors": "tsx src/scripts/seedCompetitors.ts",
    "db:backup": "tsx src/scripts/db/backup.ts",
    "db:restore": "tsx src/scripts/db/restore.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@types/cli-progress": "^3.11.6",
    "cli-progress": "^3.12.0",
    "dotenv": "^17.4.2",
    "grammy": "^1.45.1",
    "input": "^1.0.1",
    "next": "16.2.11",
    "node-cron": "^4.6.0",
    "openai": "^6.49.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "telegram": "^2.26.22",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "prisma": "^7.9.0",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
