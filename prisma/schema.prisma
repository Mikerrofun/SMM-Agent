// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Модель данных описана в docs/DataArchitecture.md
// Векторная часть (pgvector, embeddings) — в docs/Embeddings.md

generator client {
  provider = "prisma-client"
  output   = "../src/db/generated"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum IdeaStatus {
  NEW
  SENT
  SELECTED
  REJECTED
  DUPLICATE
}

enum RunStatus {
  RUNNING
  SUCCESS
  FAILED
}

// ─────────────────────────────────────────────────────────────
// Competitor — Telegram-каналы конкурентов
// ─────────────────────────────────────────────────────────────

model Competitor {
  id        String   @id @default(cuid())
  name      String
  url       String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  posts CompetitorPost[]

  @@index([isActive])
}

// ─────────────────────────────────────────────────────────────
// CompetitorPost — оригинальные посты конкурентов
// Основной источник для генерации идей.
// ─────────────────────────────────────────────────────────────

model CompetitorPost {
  id              String   @id @default(cuid())
  competitorId    String
  telegramPostUrl String   @unique
  text            String
  publishedAt     DateTime
  isProcessed     Boolean  @default(false)
  createdAt       DateTime @default(now())

  competitor Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  idea       Idea?

  @@index([competitorId])
  @@index([isProcessed])
  @@index([publishedAt])
}

// ─────────────────────────────────────────────────────────────
// NataliaPost — база знаний для проверки повторов
// Используется для дедупликации идей через embedding.
// ─────────────────────────────────────────────────────────────

model NataliaPost {
  id          String   @id @default(cuid())
  text        String
  mainIdea    String
  telegramPostUrl String   @unique
  // pgvector: Prisma хранит как Unsupported, работаем через raw SQL
  embedding   Unsupported("vector(1536)")?
  publishedAt DateTime?
  createdAt   DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
// Idea — идеи, созданные AI из поста конкурента
// ─────────────────────────────────────────────────────────────

model Idea {
  id               String   @id @default(cuid())
  competitorPostId String   @unique
  title            String
  mainIdea           String
  goal             String
  // pgvector: вектор от title + thesis, для дедупликации. См. Embeddings.md
  embedding        Unsupported("vector(1536)")?
  status           IdeaStatus @default(NEW)
  // Поля для отслеживания дубликатов (заполняются при similarity >= 0.85)
  duplicateOfType  String? // 'idea' | 'nataliaPost'
  duplicateOfId    String? // ID оригинальной записи (Idea.id или NataliaPost.id)
  similarity       Float?  // Значение cosine similarity (0.0 - 1.0)
  createdAt        DateTime @default(now())

  competitorPost CompetitorPost @relation(fields: [competitorPostId], references: [id], onDelete: Cascade)
  generatedPost  GeneratedPost?

  @@index([status])
}

// ─────────────────────────────────────────────────────────────
// GeneratedPost — готовый пост (черновик) на основе выбранной идеи
// ─────────────────────────────────────────────────────────────

model GeneratedPost {
  id        String   @id @default(cuid())
  ideaId    String   @unique
  text      String
  createdAt DateTime @default(now())

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────
// GenerationRun — служебная запись о каждом прогоне генерации
// ─────────────────────────────────────────────────────────────

model GenerationRun {
  id             String    @id @default(cuid())
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  processedPosts Int       @default(0)
  generatedIdeas Int       @default(0)
  acceptedIdeas  Int       @default(0)
  rejectedIdeas  Int       @default(0)
  openaiRequests Int       @default(0)
  status         RunStatus @default(RUNNING)

  @@index([status])
  @@index([startedAt])
}
