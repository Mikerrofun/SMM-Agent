generator client {
  provider = "prisma-client"
  output   = "../src/db/generated"
}

datasource db {
  provider = "postgresql"
}

model Competitor {
  id        String           @id @default(cuid())
  name      String
  url       String           @unique
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  posts     CompetitorPost[]

  @@index([isActive])
}

model CompetitorPost {
  id              String     @id @default(cuid())
  competitorId    String
  telegramPostUrl String     @unique
  text            String
  publishedAt     DateTime
  isProcessed     Boolean    @default(false)
  createdAt       DateTime   @default(now())
  competitor      Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  idea            Idea?

  @@index([competitorId])
  @@index([isProcessed])
  @@index([publishedAt])
}

model NataliaPost {
  id              String                 @id @default(cuid())
  text            String
  mainIdea        String
  embedding       Unsupported("vector")?
  publishedAt     DateTime?
  createdAt       DateTime               @default(now())
  telegramPostUrl String                 @unique
}

model Idea {
  id               String                 @id @default(cuid())
  competitorPostId String                 @unique
  title            String
  mainIdea         String
  goal             String
  embedding        Unsupported("vector")?
  status           IdeaStatus             @default(NEW)
  createdAt        DateTime               @default(now())
  duplicateOfId    String?
  duplicateOfType  String?
  similarity       Float?
  generatedPost    GeneratedPost?
  competitorPost   CompetitorPost         @relation(fields: [competitorPostId], references: [id], onDelete: Cascade)

  @@index([status])
}

model GeneratedPost {
  id        String   @id @default(cuid())
  ideaId    String   @unique
  text      String
  createdAt DateTime @default(now())
  mainIdea  String?
  idea      Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
}

model ClientTranscript {
  id          String           @id @default(cuid())
  text        String
  fileName    String?
  uploadedAt  DateTime         @default(now())
  processedAt DateTime?
  posts       TranscriptPost[]

  @@index([uploadedAt])
}

model TranscriptPost {
  id              String                 @id @default(cuid())
  transcriptId    String
  text            String
  mainIdea        String
  embedding       Unsupported("vector")?
  similarity      Float?
  duplicateOfType String?
  duplicateOfId   String?
  attemptNumber   Int                    @default(1)
  createdAt       DateTime               @default(now())
  status          TranscriptPostStatus   @default(REJECTED)
  transcript      ClientTranscript       @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@index([transcriptId])
  @@index([duplicateOfId])
  @@index([transcriptId, status])
}

model GenerationRun {
  id             String    @id @default(cuid())
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  processedPosts Int       @default(0)
  generatedIdeas Int       @default(0)
  acceptedIdeas  Int       @default(0)
  rejectedIdeas  Int       @default(0)
  openaiRequests Int       @default(0)
  status         RunStatus @default(RUNNING)

  @@index([status])
  @@index([startedAt])
}

enum IdeaStatus {
  NEW
  SENT
  SELECTED
  REJECTED
  DUPLICATE
}

enum RunStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum TranscriptPostStatus {
  REJECTED
  SENT
  DUPLICATE
}
